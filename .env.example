# ========================================================
# Vicky AI Chess Database Configuration (.env)
# ========================================================

# OPTION 1: MongoDB Atlas (Free Cloud Database - Recommended)
# Replace with your free MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB_NAME=vicky_chess_db

# OPTION 2: Local MongoDB Service (if installed locally on your PC)
# MONGO_URI=mongodb://127.0.0.1:27017
# MONGO_DB_NAME=vicky_chess_db

# OPTION 3: Automatic Local SQLite Fallback (Zero setup required)
# If MONGO_URI is omitted or MongoDB is unreachable, the system 
# automatically saves all users and matches to: backend/vicky_chess.db

